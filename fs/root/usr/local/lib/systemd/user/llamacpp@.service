[Unit]
Description=llama.cpp server (parameterized, llama-swap managed)
StartLimitIntervalSec=1m
StartLimitBurst=5

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/llamacpp/lib
EnvironmentFile=/opt/llm/conf/llamacpp/%i
# All llama.cpp args come from LLAMA_ARG_* vars in the EnvironmentFile.
ExecStart=/opt/llamacpp/bin/llama-server
ExecReload=/bin/kill -s HUP $MAINPID
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=120

SystemCallArchitectures=native
MemoryDenyWriteExecute=true
NoNewPrivileges=true

# kap
SyslogIdentifier=%N

[Install]
WantedBy=default.target
