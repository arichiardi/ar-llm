		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.79.10",
		"@earendil-works/pi-coding-agent": "0.79.10",
		"@types/node": "^25.6.0",
		"typescript": "^6.0.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arichiardi/ar-llm.git",
		"directory": "extensions/pi-handoff"
	},
	"homepage": "https://github.com/arichiardi/ar-llm/tree/main/extensions/pi-handoff#readme"
}
