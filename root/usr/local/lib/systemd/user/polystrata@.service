[Unit]
Description=PolyStrata server (parameterized)
StartLimitIntervalSec=1m
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/llm/conf/polystrata
EnvironmentFile=/opt/llm/conf/polystrata/common
EnvironmentFile=-/opt/llm/conf/polystrata/%i
ExecStart=/opt/llm/bin/polystrata-wrap --config /opt/llm/conf/polystrata/%i.json $STRATA_ARGS
ExecReload=/bin/kill -s HUP $MAINPID
Restart=no
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120

# kap
SyslogIdentifier=%N

[Install]
WantedBy=default.target
