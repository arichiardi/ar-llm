PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

VLLM_LOGGING_LEVEL=INFO
VLLM_NO_USAGE_STATS=1
VLLM_TRANSFORMERS_OFFLINE=1
VLLM_HF_DATASET_OFFLINE=1

SM_VLLM_HOST=0.0.0.0
SM_VLLM_PORT=8000

SM_VLLM_SERVED_MODEL_NAME=gpt-oss-120b

SM_VLLM_MODEL=/root/models/unsloth/gpt-oss-120b

# vllm >= v0.9.1
#VLLM_ATTENTION_BACKEND=FLEX_ATTENTION
#SM_VLLM_NUM_GPU_BLOCKS_OVERRIDE=128
#SM_VLLM_TENSOR_PARALLEL_SIZE=1

SM_VLLM_TOOL_CALL_PARSER=openai

SM_VLLM_TENSOR_PARALLEL_SIZE=2
SM_VLLM_GPU_MEMORY_UTILIZATION=0.93
SM_VLLM_MAX_MODEL_LEN=32768
#SM_VLLM_MAX_MODEL_LEN=131072
SM_VLLM_MAX_NUM_SEQS=16

SM_VLLM_CPU_OFFLOAD_GB=10

# https://docs.vllm.ai/en/latest/configuration/optimization.html#performance-tuning-with-chunked-prefill
SM_VLLM_MAX_NUM_BATCHED_TOKENS=256

# https://docs.vllm.ai/en/latest/features/quantization/quantized_kvcache.html#example-usage
SM_VLLM_KV_CACHE_DTYPE=fp8_e5m2

# https://github.com/vllm-project/recipes/blob/main/OpenAI/GPT-OSS.md
SM_VLLM_ASYNC_SCHEDULING=1
