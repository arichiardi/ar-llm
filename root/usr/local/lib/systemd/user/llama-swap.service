[Unit]
Description=llama-swap model swapper (OpenAI and Anthropic proxy)
Documentation=https://github.com/mostlygeek/llama-swap
After=syslog.target network.target local-fs.target remote-fs.target nss-lookup.target

[Service]
Type=simple
WorkingDirectory=/opt/llm/conf/llama-swap
EnvironmentFile=/opt/llm/conf/llama-swap/common
Environment=PATH=/opt/llm/bin:/opt/nvidia/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
Environment=LACT_DAEMON_SOCKET_PATH=/run/lactd.sock

ExecStart=/opt/llm/bin/llamaswap-wrap $LLAMA_SWAP_ARGS
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120

# kap
SyslogIdentifier=%N

[Install]
WantedBy=default.target
