[Unit]
Description=ik_llama.cpp server (parameterized)
StartLimitIntervalSec=1m
StartLimitBurst=5

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/ik_llama/lib
EnvironmentFile=/opt/llm/conf/ik_llama/%i
ExecStart=/opt/ik_llama/bin/llama-server $LLAMA_ARGS
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure

# kap
SyslogIdentifier=%N

[Install]
WantedBy=default.target
