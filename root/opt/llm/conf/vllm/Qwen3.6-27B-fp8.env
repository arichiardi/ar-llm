SM_VLLM_SERVED_MODEL_NAME=Qwen3.X-27B

SM_VLLM_MODEL=/root/models/RedHatAI/Qwen3.6-27B-FP8
#SM_VLLM_MODEL=/root/models/Qwen/Qwen3.6-27B-FP8

SM_VLLM_CHAT_TEMPLATE=/root/chat-templates/qwen-fixed-froggeric-v21.jinja

SM_VLLM_REASONING_PARSER=qwen3

SM_VLLM_ENABLE_AUTO_TOOL_CHOICE=
SM_VLLM_TOOL_CALL_PARSER=qwen3_coder

SM_VLLM_KV_CACHE_DTYPE=fp8_e4m3

SM_VLLM_ATTENTION_BACKEND=FLASHINFER
SM_VLLM_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}

SM_VLLM_GPU_MEMORY_UTILIZATION=0.95
SM_VLLM_MAX_MODEL_LEN=auto

SM_VLLM_MAX_NUM_SEQS=4

# the warning is noise for MTP — you can safely lower it. With MTP:
#   max_num_scheduled_tokens = 4096 − 0 = 4096

SM_VLLM_MAX_NUM_BATCHED_TOKENS=4096
SM_VLLM_ENABLE_CHUNKED_PREFILL=
SM_VLLM_ENABLE_PREFIX_CACHING=

SM_VLLM_TENSOR_PARALLEL_SIZE=2

SM_VLLM_COMPILATION_CONFIG={"cudagraph_mode": "PIECEWISE"}
