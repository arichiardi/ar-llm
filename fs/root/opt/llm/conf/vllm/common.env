CUDA_VISIBLE_DEVICES=0,1

TORCH_CUDA_ARCH_LIST=8.0 8.6 8.7

# https://github.com/vllm-project/vllm/issues/9046
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1

VLLM_ENABLE_CUDAGRAPH_GC=1
VLLM_USE_FLASHINFER_SAMPLER=1

# Set NCCL to verbose logging and watch for P2P enablement
NCCL_DEBUG=INFO
# make sure it's NOT disabled
NCCL_P2P_DISABLE=0
# shared memory helps on same node
NCCL_SHM_DISABLE=0
# https://www.reddit.com/r/LocalLLaMA/comments/1u0a2dg/2x3090_symmmemcommunicator_device_capability_86/
VLLM_ALLREDUCE_USE_SYMM_MEM=0

# https://github.com/vllm-project/vllm/blob/main/docs/models/extensions/instanttensor.md
# <NOT WORKING>
#SM_VLLM_LOAD_FORMAT=instanttensor

# https://docs.vllm.ai/en/stable/cli/run-batch/?h=request+log#-enable-log-requests-no-enable-log-requests
VLLM_LOGGING_LEVEL=INFO
SM_VLLM_DISABLE_ACCESS_LOG_FOR_ENDPOINTS=/health,/metrics,/ping
SM_VLLM_ENABLE_LOG_REQUESTS=

SM_VLLM_NO_USE_TQDM_ON_LOAD=

SM_VLLM_HOST=0.0.0.0
SM_VLLM_PORT=8000
