# llama-swap - settings shared by every start

LLAMA_SWAP_BIN=/usr/bin/llama-swap

# Config is a directory of fragments, merged in filename order.
LLAMA_SWAP_CONFIG_DIR=/opt/llm/conf/llama-swap

LLAMA_SWAP_LISTEN=127.0.0.1:20434
LLAMA_SWAP_WATCH_CONFIG=true

# Extra flags for llama-swap, appended by the unit line. Keep empty unless you
# need a one-off override.
LLAMA_SWAP_ARGS=
