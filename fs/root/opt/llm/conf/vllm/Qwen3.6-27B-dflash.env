# This is from the `dual-dflash.yml` setup of
#   https://github.com/noonghunna/club-3090/blob/master/docs/DUAL_CARD.md
SM_VLLM_SERVED_MODEL_NAME=Qwen3.X-27B

SM_VLLM_MODEL=/root/models/Lorbus/Qwen3.6-27B-int4-AutoRound
SM_VLLM_QUANTIZATION=auto_round

SM_VLLM_CHAT_TEMPLATE=/root/chat-templates/qwen-fixed-froggeric-v20.jinja

SM_VLLM_REASONING_PARSER=qwen3

SM_VLLM_ENABLE_AUTO_TOOL_CHOICE=
SM_VLLM_TOOL_CALL_PARSER=qwen3_coder

# DFlash was validated with FlashAttention, not FlashInfer attention.
SM_VLLM_ATTENTION_BACKEND=FLASH_ATTN

SM_VLLM_SPECULATIVE_CONFIG={"method":"dflash","model":"/root/models/z-lab/Qwen3.6-27B-DFlash","num_speculative_tokens":5}

SM_VLLM_DTYPE=bfloat16

SM_VLLM_GPU_MEMORY_UTILIZATION=0.95
SM_VLLM_MAX_MODEL_LEN=auto

SM_VLLM_MAX_NUM_SEQS=1

# https://docs.vllm.ai/en/latest/configuration/optimization.html#performance-tuning-with-chunked-prefill
SM_VLLM_MAX_NUM_BATCHED_TOKENS=8192
SM_VLLM_ENABLE_CHUNKED_PREFILL=
SM_VLLM_ENABLE_PREFIX_CACHING=

SM_VLLM_TENSOR_PARALLEL_SIZE=2
