#!/usr/bin/env bash
# Launch llama-swap with this box's directories pinned.
#
# The values come from the shared EnvironmentFile (/opt/llm/conf/llama-swap/common), so
# the unit stays free of paths and this script sets no defaults. A missing value
# fails loudly. To run it by hand, source that file first:
#   set -a; . /opt/llm/conf/llama-swap/common; set +a; llamaswap-wrap -version
#
# llama-swap takes flags, not environment variables. The LLAMA_SWAP_* names map
# to the container image convention, so both look the same in the env file.
#
# Upstream servers are children of this process. They inherit the llm user, so
# they can read /var/lib/llm/models and reach the GPU.
#
# Usage: llamaswap-wrap [extra llama-swap flags...]
set -euo pipefail

: "${LLAMA_SWAP_BIN:?LLAMA_SWAP_BIN is not set}"
: "${LLAMA_SWAP_LISTEN:?LLAMA_SWAP_LISTEN is not set}"
: "${LLAMA_SWAP_CONFIG_DIR:?LLAMA_SWAP_CONFIG_DIR is not set}"
: "${LLAMA_SWAP_WATCH_CONFIG:?LLAMA_SWAP_WATCH_CONFIG is not set}"

if [ ! -x "${LLAMA_SWAP_BIN}" ]; then
    echo "${0##*/}: binary not found: ${LLAMA_SWAP_BIN}" >&2
    exit 1
fi

if [ ! -d "${LLAMA_SWAP_CONFIG_DIR}" ]; then
    echo "${0##*/}: config dir not found: ${LLAMA_SWAP_CONFIG_DIR}" >&2
    exit 1
fi

args=("-config-dir" "${LLAMA_SWAP_CONFIG_DIR}" "-listen" "${LLAMA_SWAP_LISTEN}")

case "$(printf '%s' "${LLAMA_SWAP_WATCH_CONFIG}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on) args+=("-watch-config=true") ;;
    *) ;;
esac

# Fail fast on a broken config, instead of crash-looping the service.
if ! validate_out="$("${LLAMA_SWAP_BIN}" -validate "${args[@]}" 2>&1)"; then
    echo "${0##*/}: config failed validation: ${LLAMA_SWAP_CONFIG_DIR}" >&2
    printf '%s\n' "${validate_out}" >&2
    exit 1
fi

exec "${LLAMA_SWAP_BIN}" "${args[@]}" "$@"
