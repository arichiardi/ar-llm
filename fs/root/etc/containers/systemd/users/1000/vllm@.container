# vLLM Container Unit (podlet-generated)
#
# Usage: systemctl --user start vllm@<model-name>
#   where <model-name> selects the .env file under conf/
#   e.g.  vllm@Qwen3.6-27B  ->  conf/Qwen3.6-27B.env + conf/common.env
#
# Each .env sets SM_VLLM_* env vars consumed by sagemaker-entrypoint.sh.
# Quick HowTo:
# 1. The input will be used for reading a .env file within
#    setting environment variables for the container.
#    For instance, if the input is deepseek-r1 then we will use:
#      EnvironmentFile=/path/to/conf/deepseek-r1.env

[Unit]
Description=vLLM (parameterized)
StartLimitIntervalSec=2m
StartLimitBurst=5

[Container]
ContainerName=vllm-%i

Image=codeberg.org/k153/vllm-openai-custom:latest

AutoUpdate=registry
AddDevice=nvidia.com/gpu=all

Volume=/var/lib/llm/chat-templates:/root/chat-templates
Volume=/var/lib/llm/models/vllm:/root/models

PodmanArgs=--ipc=host

PublishPort=12434:8000

EnvironmentFile=/opt/llm/conf/vllm/%i.env
EnvironmentFile=/opt/llm/conf/vllm/common.env

# container runs as root, so no keep-id
# the vllm-openai container's main user is root (0).
#
# Therefore, we cannot use keep-id which would map the
# running host user to the container user
PodmanArgs=--pull=never --userns=""

HealthStartupRetries=3

[Service]
Restart=no
RestartSec=10
SyslogIdentifier=%N

# Extend Timeout to allow time to pull the image
TimeoutStartSec=900

[Install]
WantedBy=default.target
